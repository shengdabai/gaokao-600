# Backend
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# CORS: comma-separated list of allowed frontend origins (default: http://localhost:3000)
# In production set this to your real frontend domain, e.g. https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Optional: PostgreSQL / Supabase connection string. If unset, the app uses local SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Optional: default user id for single-user mode (default: 1)
# DEFAULT_USER_ID=1

# Frontend (if needed separately)
NEXT_PUBLIC_API_URL=http://localhost:8000
